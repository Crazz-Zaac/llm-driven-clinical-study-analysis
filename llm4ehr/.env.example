# Copy to app/.env (read by docker/docker-compose.yml, the backend and the evaluator).

# --- Qdrant ----------------------------------------------------------------
QDRANT_URL=http://qdrant:6333
# Leave empty unless Qdrant is started with an API key.
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=articles

# --- Ollama ----------------------------------------------------------------
OLLAMA_URL=http://ollama:11434
# Context window (tokens) requested from Ollama for every chat call.
OLLAMA_NUM_CTX=16384

# --- Storage (paths inside the backend container) ----------------------------
FETCHED_ARTICLES_DIR=/app/data/fetched_articles
SQLITE_DB_PATH=sqlite:////app/data/papers.db

# --- Article discovery -----------------------------------------------------
# Contact address sent to OpenAlex ("polite pool").
UNPAYWALL_EMAIL=you@example.org

# --- Hosted models (optional) ----------------------------------------------
# Used by the /rag/remote endpoint and by rag_evaluation/evaluate_rag.py as RAGAS judge.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MISTRALAI_API_KEY=
MISTRALAI_BASE_URL=https://api.mistral.ai/v1

# --- Default generation parameters -----------------------------------------
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=512
